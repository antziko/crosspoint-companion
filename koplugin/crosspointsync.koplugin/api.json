{
    "name" : "crosspoint-bookmark-sync-api",
    "methods" : {
        "get_bookmarks" : {
            "path" : "/syncs/bookmarks/:document",
            "method" : "GET",
            "required_params" : [
                "document"
            ],
            "expected_status" : [200, 401]
        },
        "update_bookmarks" : {
            "path" : "/syncs/bookmarks",
            "method" : "PUT",
            "required_params" : [
                "document",
                "bookmarks"
            ],
            "payload" : [
                "document",
                "bookmarks"
            ],
            "expected_status" : [200, 401]
        },
        "get_progress" : {
            "path" : "/syncs/progress/:document",
            "method" : "GET",
            "required_params" : [
                "document"
            ],
            "expected_status" : [200, 401]
        },
        "update_progress" : {
            "path" : "/syncs/progress",
            "method" : "PUT",
            "required_params" : [
                "document",
                "progress",
                "percentage",
                "device",
                "device_id"
            ],
            "payload" : [
                "document",
                "progress",
                "percentage",
                "device",
                "device_id"
            ],
            "expected_status" : [200, 202, 401]
        }
    }
}
